{
  "_meta": {
    "purpose": "Level 2 concept — semantic graph over telemetry.json. Graph stores no data, only access paths (tools_registry).",
    "source_of_truth": "telemetry.json (Level 1, ETL: telemetry_ai_etl.py)",
    "not_yet_wired": "route_solution.json (solver) — entities mapped in advance, not populated with data yet"
  },
  "entities": {
    "Site": {
      "description": "Single telecom tower site.",
      "key": "site_id",
      "properties": {
        "site_id": {
          "type": "string"
        },
        "region": {
          "type": "string",
          "relation": "LOCATED_IN -> Region"
        },
        "lat": {
          "type": "float|null"
        },
        "lon": {
          "type": "float|null"
        },
        "total_capacity_liters": {
          "type": "float"
        },
        "historical_cph": {
          "type": "float",
          "note": "6-month average, empirical, not rated"
        },
        "rated_cph_max": {
          "type": "float",
          "note": "rated nameplate, max(G1,G2)"
        },
        "gensets_count": {
          "type": "int"
        },
        "g1_kva": {
          "type": "float"
        },
        "g2_kva": {
          "type": "float"
        },
        "last_refuel_timestamp": {
          "type": "string|null"
        },
        "fuel_level_after_refuel": {
          "type": "float|null"
        },
        "current_fuel_estimate": {
          "type": "float|null",
          "computed_from": [
            "fuel_level_after_refuel",
            "last_refuel_timestamp",
            "dynamic_cph_trend|historical_cph"
          ]
        },
        "actual_cph_last_run": {
          "type": "float|null"
        },
        "dynamic_cph_trend": {
          "type": "float|null"
        },
        "tte_hours": {
          "type": "float|null",
          "computed_from": [
            "current_fuel_estimate",
            "dynamic_cph_trend|historical_cph"
          ]
        },
        "tte_deadline_sec": {
          "type": "int|null",
          "computed_from": [
            "tte_hours"
          ]
        },
        "solver_priority": {
          "type": "critical|planned|nominal|null",
          "computed_from": [
            "tte_hours"
          ]
        },
        "base_setup_sec": {
          "type": "int",
          "note": "constant, not per-site"
        },
        "pump_rate_lps": {
          "type": "float",
          "note": "constant, not per-site"
        },
        "estimated_max_service_time_sec": {
          "type": "float|null",
          "computed_from": [
            "fill_volume_l",
            "pump_rate_lps"
          ]
        },
        "fill_volume_l": {
          "type": "float|null",
          "computed_from": [
            "total_capacity_liters",
            "current_fuel_estimate"
          ],
          "note": "current logic: fill to capacity; discussed solution (not implemented): fill to target reserve"
        },
        "data_flags": {
          "type": "array<string>",
          "relation": "HAS_FLAG -> DataQualityFlag (many-to-many)"
        }
      },
      "relations": {
        "HAS_GENSET": {
          "target": "Genset",
          "cardinality": "1:N"
        },
        "LOCATED_IN": {
          "target": "Region",
          "cardinality": "N:1"
        },
        "HAS_FLAG": {
          "target": "DataQualityFlag",
          "cardinality": "N:N"
        },
        "HAS_ALARM_RECORD": {
          "target": "AlarmMonthlyRecord",
          "cardinality": "1:N"
        },
        "SERVED_BY_ROUTE": {
          "target": "RouteStep",
          "cardinality": "1:N",
          "status": "NOT_WIRED — solver not integrated with telemetry.json"
        }
      }
    },
    "Genset": {
      "description": "Single generator on site (from gensets_detail).",
      "key": "site_id + name (composite, name is not guaranteed unique across visits)",
      "properties": {
        "name": {
          "type": "string",
          "note": "not a persistent key over time"
        },
        "capacity_liters": {
          "type": "float",
          "note": "at visit record row level, not site level"
        },
        "fuel_before": {
          "type": "float|null"
        },
        "fuel_after": {
          "type": "float|null"
        }
      },
      "relations": {
        "BELONGS_TO": {
          "target": "Site",
          "cardinality": "N:1"
        }
      }
    },
    "Region": {
      "description": "Normalized region.",
      "key": "region (canonical)",
      "properties": {
        "region_name": {
          "type": "string"
        },
        "aliases": {
          "type": "array<string>",
          "source": "audit.register_data_issues.region_names_normalized"
        }
      },
      "relations": {
        "HAS_SITE": {
          "target": "Site",
          "cardinality": "1:N"
        },
        "HAS_MONTHLY_REPORT": {
          "target": "RegionalMonthlyReport",
          "cardinality": "1:N"
        }
      }
    },
    "RegionalMonthlyReport": {
      "description": "Reconciliation of calculated visit data vs accounting, per region/month.",
      "key": "region + month",
      "properties": {
        "month": {
          "type": "string"
        },
        "consumption_calculated_l": {
          "type": "float",
          "source_fields": [
            "audit.regional_report.regional_consumption_calculated[month][region].consumption_l",
            "audit.regional_report.regional_accounting_mismatch[].calculated_qty_l (same fact)"
          ]
        },
        "sites_counted": {
          "type": "int",
          "source_fields": [
            "audit.regional_report.regional_consumption_calculated[month][region].sites_counted",
            "audit.regional_report.regional_accounting_mismatch[].sites_counted_in_visits (same fact)"
          ]
        },
        "accounting_qty_l": {
          "type": "float",
          "source_fields": [
            "audit.regional_report.regional_accounting_summary[month][region].fuel_consumption_qty_l",
            "audit.regional_report.regional_accounting_mismatch[].accounting_qty_l (same fact)"
          ]
        },
        "accounting_cost_usd": {
          "type": "float",
          "source_fields": ["audit.regional_report.regional_accounting_summary[month][region].fuel_consumption_cost_usd"]
        },
        "delivered_qty_l": {
          "type": "float",
          "source_fields": ["audit.regional_report.regional_accounting_summary[month][region].fuel_delivered_qty_l"]
        },
        "total_sites_expected": {
          "type": "int",
          "source_fields": [
            "audit.regional_report.regional_accounting_summary[month][region].total_sites",
            "audit.regional_report.regional_accounting_mismatch[].sites_expected_by_accounting (same fact)"
          ]
        },
        "deviation_pct": {
          "type": "float|null",
          "source_fields": ["audit.regional_report.regional_accounting_mismatch[].deviation_pct"]
        },
        "likely_coverage_gap": {
          "type": "bool|null",
          "source_fields": ["audit.regional_report.regional_accounting_mismatch[].likely_coverage_gap"]
        }
      },
      "relations": {
        "BELONGS_TO": {
          "target": "Region",
          "cardinality": "N:1"
        }
      }
    },
    "DataQualityFlag": {
      "description": "Allowance flag dictionary (not site level fact, but flag definition itself).",
      "key": "flag_name",
      "properties": {
        "flag_name": {
          "type": "string"
        },
        "severity": {
          "type": "hard|soft",
          "note": "hard = missing_reading (only hard solver block); remaining 9 — soft"
        },
        "blocks_solver": {
          "type": "bool"
        }
      },
      "instances": [
        {
          "flag_name": "missing_reading",
          "severity": "hard",
          "blocks_solver": true
        },
        {
          "flag_name": "missing_capacity",
          "severity": "soft",
          "blocks_solver": false
        },
        {
          "flag_name": "missing_coordinates",
          "severity": "soft",
          "blocks_solver": false
        },
        {
          "flag_name": "ghost_site",
          "severity": "soft",
          "blocks_solver": false
        },
        {
          "flag_name": "cph_exceeds_rated",
          "severity": "soft",
          "blocks_solver": false
        },
        {
          "flag_name": "duplicate_id",
          "severity": "soft",
          "blocks_solver": false
        },
        {
          "flag_name": "missing_cph",
          "severity": "soft",
          "blocks_solver": false
        },
        {
          "flag_name": "fuel_exceeds_capacity",
          "severity": "soft",
          "blocks_solver": false
        },
        {
          "flag_name": "actual_cph_efficiency_warning",
          "severity": "soft",
          "blocks_solver": false
        },
        {
          "flag_name": "dynamic_cph_efficiency_warning",
          "severity": "soft",
          "blocks_solver": false
        }
      ],
      "relations": {
        "APPLIES_TO": {
          "target": "Site",
          "cardinality": "N:N"
        }
      }
    },
    "AlarmMonthlyRecord": {
      "description": "Network alarm record per site for a month (historical_analytics).",
      "key": "site_id + month",
      "properties": {
        "month": {
          "type": "string"
        },
        "alarms_count": {
          "type": "int"
        },
        "total_downtime_hours": {
          "type": "float"
        }
      },
      "relations": {
        "BELONGS_TO": {
          "target": "Site",
          "cardinality": "N:1"
        }
      },
      "note": "Independent time axis, not tied to site last_refuel_timestamp. clean_site_id not checked against ghost_site logic."
    },
    "RouteStep": {
      "description": "PLACEHOLDER, unpopulated. Single vehicle visit to site from route_solution.json.",
      "status": "NOT_WIRED",
      "key": "vehicle_id + site_id",
      "properties": {
        "priority": {
          "type": "string"
        },
        "arrival_min": {
          "type": "float"
        },
        "arrival_deadline_min": {
          "type": "float|null"
        },
        "arrival_slack_min": {
          "type": "float|null",
          "note": "buffer to deadline — risk indicator, not computed elsewhere"
        },
        "delivered_liters": {
          "type": "int"
        }
      },
      "relations": {
        "VISITS": {
          "target": "Site",
          "cardinality": "N:1"
        }
      }
    },
    "AuditReport": {
      "description": "Data quality report for a single parser run (telemetry.json -> audit). Run-level fact, not site-level. Key omitted as exactly one audit object exists per telemetry.json.",
      "key": "singleton (one per run)",
      "properties": {
        "master_data_issues": {
          "type": "object",
          "source": "audit.master_data_issues",
          "fields": {
            "duplicate_ids":        {"type": "array<site_id>", "note": "duplicate ID Number in master data"},
            "missing_cph_active":   {"type": "array<site_id>", "note": "zero CPH, site present in visits"},
            "missing_cph_orphan":   {"type": "array<site_id>", "note": "zero CPH, site missing in visits"},
            "cph_exceeds_rated":    {"type": "array<site_id>", "note": "historical_cph > rated_cph_max × 1.10"}
          }
        },
        "dynamic_data_issues": {
          "type": "object",
          "source": "audit.dynamic_data_issues",
          "fields": {
            "sites_missing_capacity":                {"type": "array<site_id>"},
            "sites_missing_reading":                  {"type": "array<site_id>", "note": "hard solver block"},
            "sites_missing_coordinates":               {"type": "array<site_id>"},
            "sites_fuel_exceeds_capacity":             {"type": "array<site_id>"},
            "sites_actual_cph_efficiency_warning":     {"type": "array<site_id>"},
            "sites_dynamic_cph_efficiency_warning":    {"type": "array<site_id>"},
            "telemetry_glitches": {
              "type": "object",
              "fields": {
                "total_visits":    {"type": "int"},
                "valid_visits":    {"type": "int"},
                "glitches_caught": {"type": "int"}
              }
            }
          }
        },
        "register_data_issues": {
          "type": "object",
          "source": "audit.register_data_issues",
          "fields": {
            "ghost_sites":              {"type": "array<site_id>", "note": "present in visits, missing in master data"},
            "region_names_normalized":  {"type": "object", "note": "canonical -> [spelling variations]"},
            "regions_unmatched": {
              "type": "array",
              "item_fields": {
                "month":  {"type": "string"},
                "region": {"type": "string"},
                "source": {"type": "accounting_only|calculated_only", "note": "source missing the region"}
              }
            },
            "possible_region_aliases": {
              "type": "array",
              "item_fields": {
                "month":            {"type": "string"},
                "accounting_name":  {"type": "string", "note": "region name from accounting extract"},
                "calculated_name":  {"type": "string", "note": "region name in visit calculation"}
              }
            }
          }
        },
        "summary_report": {
          "type": "object",
          "source": "audit.summary_report",
          "fields": {
            "count_duplicate_ids": {"type": "int"},
            "count_missing_cph_active": {"type": "int"},
            "count_missing_cph_orphan": {"type": "int"},
            "count_cph_exceeds_rated": {"type": "int"},
            "count_missing_capacity": {"type": "int"},
            "count_missing_reading": {"type": "int"},
            "count_missing_coordinates": {"type": "int"},
            "count_fuel_exceeds_capacity": {"type": "int"},
            "count_actual_cph_efficiency_warning": {"type": "int"},
            "count_dynamic_cph_efficiency_warning": {"type": "int"},
            "count_glitches_found": {"type": "int"},
            "count_ghost_sites": {"type": "int"},
            "count_regions_unmatched": {"type": "int"},
            "count_regional_mismatch": {"type": "int"},
            "count_sites_with_alarms": {"type": "int"}
          }
        }
      },
      "relations": {}
    }
  },
  "tools_registry": {
    "_note": "Binds graph nodes/properties to specific Level 1 functions or paths. While data remains in a single JSON file, tools act as direct lookups on telemetry.json, serving as a fallback for future SQL layers.",
    "get_site_by_id": {
      "type": "lookup",
      "source": "telemetry.json -> telemetry[]",
      "match": "site_id",
      "returns": "Site"
    },
    "get_sites_by_priority": {
      "type": "filter",
      "source": "telemetry.json -> telemetry[]",
      "match": "solver_priority",
      "returns": "Site[]"
    },
    "get_sites_by_flag": {
      "type": "filter",
      "source": "telemetry.json -> telemetry[]",
      "match": "data_flags contains X",
      "returns": "Site[]"
    },
    "get_regional_mismatch": {
      "type": "lookup",
      "source": "telemetry.json -> audit.regional_report.regional_accounting_mismatch",
      "returns": "RegionalMonthlyReport[]"
    },
    "get_alarm_history_for_site": {
      "type": "lookup",
      "source": "telemetry.json -> audit.historical_analytics",
      "match": "site_id",
      "returns": "AlarmMonthlyRecord[]"
    },
    "get_flag_definition": {
      "type": "static_lookup",
      "source": "ontology_schema.json -> entities.DataQualityFlag.instances",
      "returns": "DataQualityFlag"
    },
    "get_audit_report": {
      "type": "lookup",
      "source": "telemetry.json -> audit",
      "returns": "AuditReport",
      "note": "Returns entire audit block (singleton, no match param) — parser run data quality: reference data, visits, region reconciliation, accounting mismatch, summary counters."
    },
    "compute_route_for_site": {
      "type": "function",
      "source": "solver_soft.py",
      "status": "NOT_WIRED — solver not run on telemetry.json, cannot call, marked only as available capability"
    },
    "count_sites_by_priority": {
      "type": "count",
      "source": "telemetry.json -> telemetry[]",
      "match": "solver_priority",
      "returns": "int",
      "description": "Returns site count (int) where solver_priority matches requested value (e.g., critical, planned, nominal)."
    },
    "count_sites_by_flag": {
      "type": "count",
      "source": "telemetry.json -> telemetry[]",
      "match": "data_flags contains X",
      "returns": "int",
      "description": "Returns site count (int) where data_flags array contains specified flag (e.g., missing_reading, duplicate_id)."
    },
    "recompute_tte_live": {
      "type": "function",
      "status": "NOT_NEEDED — tte_hours precomputed at Level 1, live recalculation not required unless input assumptions change"
    }
  }
}